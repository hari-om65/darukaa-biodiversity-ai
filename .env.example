# Copy this file to .env and fill in real values. Never commit .env.

# Required. Anthropic API key used by app/composer.py (via the anthropic SDK)
# to call Claude for /chat and /chat/structured recommendations.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Overrides the Claude model used by the composer.
# Defaults to "claude-sonnet-4-6" if unset (see app/composer.py).
ANTHROPIC_MODEL=

# Optional. Overrides where the ChromaDB persistent store lives.
# Defaults to knowledge/chroma_db if unset (see knowledge/ingestion/ingest.py).
# Point this at a mounted volume in production so the vector store survives
# container restarts/redeploys.
CHROMA_DB_DIR=
