# Copy this file to .env and fill in real values. Never commit .env.

# Required. Groq API key used by app/composer.py (via the groq SDK) to call
# Groq for /chat and /chat/structured recommendations.
# Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Overrides the Groq model used by the composer.
# Defaults to "openai/gpt-oss-120b" if unset (see app/composer.py).
GROQ_MODEL=

# Optional. Overrides where the ChromaDB persistent store lives.
# Defaults to knowledge/chroma_db if unset (see knowledge/ingestion/ingest.py).
# Point this at a mounted volume in production so the vector store survives
# container restarts/redeploys.
CHROMA_DB_DIR=
